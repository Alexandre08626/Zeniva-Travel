{
  "name": "ZeniPay AI - Auto-review Transactions",
  "nodes": [
    {
      "name": "CRON Trigger",
      "type": "n8n-nodes-base.cron",
      "parameters": { "triggerTimes": { "item": [{ "mode": "everyHour" }] } }
    },
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "GET",
        "url": "https://zeniva-dev-dashboard.vercel.app/api/automation/zenipay?secret=zeniva-cron-2026",
        "authentication": "none"
      }
    },
    {
      "name": "If Flagged",
      "type": "n8n-nodes-base.if",
      "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "fieldName": "results.0.flagged", "operator": "equal", "value": true }] } }
    },
    {
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "parameters": { "channel": "C-zenipay-alerts", "text": "=ZeniPay AI flagged: {{$json.results[0].reply}}" }
    }
  ],
  "connections": {
    "CRON Trigger": { "main": [[ { "node": "HTTP Request", "type": "main", "index": 0 } ]] },
    "HTTP Request": { "main": [[ { "node": "If Flagged", "type": "main", "index": 0 } ]] },
    "If Flagged": { "main": [[ { "node": "Slack Alert", "type": "main", "index": 0 } ]] }
  }
}
