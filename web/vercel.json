{
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/marco-prospecting",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sofia-auto-reply",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "app/api/proposals/generate-pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/cron/marco-prospecting/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/sofia-auto-reply/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/indexnow/route.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/tiktokT6qzksZRDhq8epwtEK902HQOgOKb0ffn.txt",
      "destination": "/api/tiktok-verify?file=tiktokT6qzksZRDhq8epwtEK902HQOgOKb0ffn.txt"
    },
    {
      "source": "/tiktoky9rJttREqSiVX7eEdqRtUX1QH98JhMd5.txt",
      "destination": "/api/tiktok-verify?file=tiktoky9rJttREqSiVX7eEdqRtUX1QH98JhMd5.txt"
    }
  ]
}
