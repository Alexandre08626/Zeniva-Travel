# Images are committed as regular files: Vercel does not fetch Git LFS content at build
# time, so LFS-tracked photos were served as 131-byte pointer files (broken ZeniStay photos).
*.tif filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
web/app/icon.png -filter -diff -merge -text
web/public/branding/lina-avatar.png -filter -diff -merge -text
web/public/branding/logo.png -filter -diff -merge -text
web/public/yachts/** -filter -diff -merge -text

web/public/residence-photos/** -filter -diff -merge -text
web/public/agents/** -filter -diff -merge -text
